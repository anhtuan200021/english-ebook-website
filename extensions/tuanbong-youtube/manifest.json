{
  "manifest_version": 3,
  "name": "TuanBong · Học ngay trên YouTube",
  "version": "0.3.5",
  "description": "Thêm nút Học cùng TuanBong trên YouTube, tự mở bản chép lời và chuyển sang bài học. Không API trả phí.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://english-ebook-website.pages.dev/youtube/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "action": {
    "default_title": "Đưa vào TuanBong",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://english-ebook-website.pages.dev/youtube/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "extract.js",
        "youtube.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
